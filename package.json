{
  "name": "agent-approval-machine",
  "version": "0.1.0",
  "description": "Framework-free approval state machines for AI agents: edit before approve, partial failure with retry, undo windows, and a queue for items that arrive mid-flight. Zero dependencies, no UI, works in any JavaScript runtime.",
  "keywords": [
    "ai",
    "agents",
    "human-in-the-loop",
    "approval",
    "state-machine",
    "headless",
    "framework-agnostic",
    "zero-dependency",
    "vanilla-js",
    "react",
    "vue",
    "svelte",
    "angular"
  ],
  "license": "MIT",
  "author": "mzubairhassan18",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzubairhassan18/agent-approval-machine.git"
  },
  "homepage": "https://github.com/mzubairhassan18/agent-approval-machine#readme",
  "bugs": {
    "url": "https://github.com/mzubairhassan18/agent-approval-machine/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
