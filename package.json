{
  "name": "agent-approval-machine",
  "version": "0.1.0",
  "description": "Headless approval state machines for AI agents. Edit-before-approve, partial failure, undo windows and queued items. Framework-free core, plus a React binding and ready UI.",
  "keywords": [
    "ai",
    "agents",
    "human-in-the-loop",
    "approval",
    "state-machine",
    "headless",
    "framework-agnostic",
    "react",
    "hooks",
    "ai-sdk"
  ],
  "license": "MIT",
  "author": "mzubairhassan18",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzubairhassan18/agent-approval-machine.git"
  },
  "homepage": "https://github.com/mzubairhassan18/agent-approval-machine#readme",
  "bugs": {
    "url": "https://github.com/mzubairhassan18/agent-approval-machine/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js",
      "require": "./dist/store/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./machines": {
      "types": "./dist/machines/index.d.ts",
      "import": "./dist/machines/index.js",
      "require": "./dist/machines/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "require": "./dist/adapters/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup && node scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "registry": "node scripts/build-registry.mjs",
    "demo": "pnpm build && pnpm --filter demo dev",
    "demo:build": "pnpm build && pnpm --filter demo build",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
